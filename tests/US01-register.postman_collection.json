      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "const body = pm.response.json();",
              "pm.test('Respuesta sin contraseña ni token', () => { for (const key of ['password', 'passwordHash', 'password_hash', 'token']) pm.expect(body).not.to.have.property(key); });",
              "pm.test('Mensaje esperado', () => pm.expect(body.message).to.eql(\"El correo institucional ya está vinculado a una cuenta existente\"));"
            ]
          }
        }
      ]
