{
  "info": {
    "name": "KodikaLab - US-01 Registro modular",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Validación de US-01. Ejecutar en orden con Collection Runner. Crea tres usuarios de prueba por corrida; no borra datos. No usa JWT ni implementa login. Consultar tests/README.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === '01 Registro exitoso - PRACTITIONER' || !pm.collectionVariables.get('registrationEmail')) {",
          "  const id = pm.variables.replaceIn('{{$guid}}');",
          "  const email = `us01.${id}@upc.edu.pe`;",
          "  pm.collectionVariables.set('registrationEmail', email);",
          "  pm.collectionVariables.set('uppercaseEmail', email.toUpperCase());",
          "  pm.collectionVariables.set('coachEmail', `us01.coach.${id}@upc.edu.pe`);",
          "  pm.collectionVariables.set('adminEmail', `us01.admin.${id}@upc.edu.pe`);",
          "  pm.collectionVariables.set('invalidEmail', `us01.invalid.${id}@upc.edu.pe`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Registro exitoso - PRACTITIONER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Matias\",\n  \"lastName\": \"Del Castillo\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"PRACTITIONER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "description": "Inicia una corrida nueva y genera correos únicos. Ejecutar primero."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Respuesta sin contraseña ni token', () => { for (const key of ['password', 'passwordHash', 'password_hash', 'token']) pm.expect(body).not.to.have.property(key); });",
              "pm.test('Mensaje esperado', () => pm.expect(body.message).to.eql(\"Registro exitoso\"));",
              "pm.test('Rol seleccionado', () => pm.expect(body.role).to.eql(\"PRACTITIONER\"));",
              "pm.test('Correo normalizado', () => pm.expect(body.email).to.eql(pm.variables.replaceIn(\"{{registrationEmail}}\").trim().toLowerCase()));",
              "pm.test('Solo campos públicos', () => pm.expect(Object.keys(body).sort()).to.eql(['email', 'message', 'role']));"
            ]
          }
        }
      ]
    },
    {
