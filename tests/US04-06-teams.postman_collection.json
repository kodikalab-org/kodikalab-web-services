        "body": {
          "mode": "raw",
          "raw": "{\n  \"especialidadPrincipal\": \"Grafos\",\n  \"organizacionClub\": \"Club ICPC\",\n  \"aniosExperiencia\": 4,\n  \"presentacion\": \"Coach para pruebas Teams\"\n}",
