{
  "info": {
    "name": "KodikaLab - US04 US05 US06 Teams",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flujo secuencial de Teams. Ejecutar con Collection Runner, cookie jar habilitado y servidor local activo. Crea usuarios, perfiles y grupos de prueba en la base conectada al servidor. No ejecutar en producción."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Password123",
      "type": "string"
    },
    {
      "key": "coachEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "practitionerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondPractitionerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherCoachEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Registrar COACH",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"COACH\",\n  \"lastName\": \"Teams\",\n  \"email\": \"{{coachEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"COACH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12);",
              "pm.collectionVariables.set('runId', id);",
              "for (const [key, prefix] of [['coachEmail','coach'], ['practitionerEmail','practitioner'], ['secondPractitionerEmail','second'], ['otherCoachEmail','othercoach']]) { pm.collectionVariables.set(key, `teams.${prefix}.${id}@gmail.com`); }",
              "pm.collectionVariables.set('studentCodeA', `TA${id}`);",
              "pm.collectionVariables.set('studentCodeB', `TB${id}`);",
              "for (const key of ['groupA','groupB','groupPublic','membershipA','membershipB','inviteA']) pm.collectionVariables.unset(key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Rol COACH', () => pm.expect(pm.response.json().role).to.eql('COACH'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login COACH",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{coachEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Sesión COACH', () => pm.expect(pm.response.json().role).to.eql('COACH'));",
              "pm.test('Cookie JSESSIONID presente', () => pm.expect(pm.cookies.get('JSESSIONID')).to.be.ok);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Completar perfil COACH",
      "request": {
        "method": "PUT",
        "header": [
          {
