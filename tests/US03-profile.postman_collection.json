{
  "info": {
    "name": "KodikaLab - US03 Perfil practicante ERD oficial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para validar US-03 según docs/sdd/assets/oficial.erd. Ejecutar en orden: cada login guarda el token JWT en la variable de colección token y las demás solicitudes lo envían como Bearer. Prevalece ERD: Codeforces, AtCoder y VJudge; LeetCode no se persiste. No realiza commits ni cambios de código."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith('01 ') || !pm.collectionVariables.get('profileEmail')) {",
          "  const id = pm.variables.replaceIn('{{$guid}}').slice(0, 8);",
          "  pm.collectionVariables.set('runId', id);",
          "  pm.collectionVariables.set('profileEmail', `test.us03.${id}@gmail.com`);",
          "  pm.collectionVariables.set('coachEmail', `test.us03.coach.${id}@gmail.com`);",
          "  pm.collectionVariables.set('otherPractitionerEmail', `test.us03.other.${id}@gmail.com`);",
          "  pm.collectionVariables.set('studentCode', `US03${id}`);",
          "  pm.collectionVariables.set('otherStudentCode', `US03O${id}`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Registrar PRACTICANTE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Usuario\",\n  \"lastName\": \"Perfil\",\n  \"email\": \"{{profileEmail}}\",\n  \"password\": \"Password123\",\n  \"role\": \"PRACTICANTE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Registro exitoso', () => pm.expect(body.message).to.eql('Registro exitoso'));",
              "pm.test('Rol PRACTICANTE', () => pm.expect(body.role).to.eql('PRACTICANTE'));",
              "pm.test('Sin datos sensibles', () => { for (const key of ['password', 'passwordHash', 'password_hash', 'token']) pm.expect(body).not.to.have.property(key); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login PRACTICANTE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{profileEmail}}\",\n  \"password\": \"Password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Login exitoso', () => pm.expect(body.message).to.eql('Inicio de sesión exitoso'));",
              "pm.test('Rol desde cuenta', () => pm.expect(body.role).to.eql('PRACTICANTE'));",
              "pm.test('Token JWT recibido', () => { const b = pm.response.json(); pm.expect(b.token).to.be.a('string'); pm.expect(b.tokenType).to.eql('Bearer'); });",
              "const issuedToken = pm.response.json().token; if (issuedToken) pm.collectionVariables.set('token', issuedToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 GET perfil antes de completarlo devuelve 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Perfil aún no registrado', () => pm.expect(pm.response.json().message).to.eql('El perfil de practicante aún no está registrado'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear perfil PRACTICANTE según ERD",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoEstudiante\": \"{{studentCode}}\",\n  \"carrera\": \"Ingeniería de Software\",\n  \"cicloAcademico\": 5,\n  \"nivelCompetitivo\": \"INTERMEDIO\",\n  \"codeforcesHandle\": \"tourist\",\n  \"atcoderHandle\": \"tourist_atcoder\",\n  \"vjudgeHandle\": \"usuario_vjudge\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Mensaje esperado', () => pm.expect(body.message.startsWith('Perfil actualizado correctamente')).to.be.true);",
              "pm.test('Perfil corresponde al practicante autenticado', () => { pm.expect(body.profile.email).to.eql(pm.collectionVariables.get('profileEmail')); pm.expect(body.profile.role).to.eql('PRACTICANTE'); });",
              "pm.test('Campos ERD persistidos', () => { pm.expect(body.profile.codigoEstudiante).to.eql(pm.collectionVariables.get('studentCode')); pm.expect(body.profile.nivelCompetitivo).to.eql('INTERMEDIO'); pm.expect(body.profile.codeforcesHandle === null || body.profile.codeforcesHandle === 'tourist').to.be.true; pm.expect(body.profile.atcoderHandle).to.eql('tourist_atcoder'); pm.expect(body.profile.vjudgeHandle).to.eql('usuario_vjudge'); });",
              "pm.test('Sin LeetCode ni datos sensibles', () => { for (const key of ['leetcodeHandle', 'password', 'passwordHash', 'password_hash', 'token']) pm.expect(body.profile).not.to.have.property(key); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Consultar perfil PRACTICANTE",
      "request": {
        "method": "GET",
        "header": [],
