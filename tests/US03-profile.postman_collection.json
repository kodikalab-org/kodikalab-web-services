              "const body = pm.response.json();",
              "pm.test('Perfil obtenido', () => pm.expect(body.message).to.eql('Perfil obtenido correctamente'));",
              "pm.test('Código estudiante conservado', () => pm.expect(body.profile.codigoEstudiante).to.eql(pm.collectionVariables.get('studentCode')));",
              "pm.test('No expone passwordHash', () => pm.expect(body.profile).not.to.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
