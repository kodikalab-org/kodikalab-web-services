# Configure these variables in Render; never commit a filled copy.
SPRING_PROFILES_ACTIVE=prod
# Supabase > Connect > Session pooler (IPv4-compatible). Copy the exact host/user.
# Use JDBC syntax, NOT postgres://. Password stays separate, no URL encoding needed.
DB_JDBC_URL=jdbc:postgresql://YOUR-SESSION-POOLER.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR-PROJECT-REF
DB_PASSWORD=
DB_POOL_SIZE=5
JWT_SECRET=
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
# Requires an existing schema created by an approved migration.
JPA_DDL_AUTO=validate
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
