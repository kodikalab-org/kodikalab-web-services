# Spring loads .env automatically when launched from the backend root.
# For Supabase use its Session pooler JDBC URL (see .env.production.example).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kodikalab_db
DB_USER=postgres
DB_PASSWORD=postgres

# Obligatorio: minimo 32 caracteres, sin valor por defecto. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Optional override for Supabase, includes sslmode=require; omit for local PostgreSQL.
# DB_JDBC_URL=jdbc:postgresql://YOUR-SESSION-POOLER:5432/postgres?sslmode=require
